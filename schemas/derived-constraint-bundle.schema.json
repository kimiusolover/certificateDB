{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certificate-db.example/schemas/derived-constraint-bundle.schema.json",
  "title": "DerivedConstraintBundle",
  "description": "A reproducible evidence-derived constraint bundle; never an RF permission or runtime configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "jurisdiction", "deviceRef", "inputs", "derivation", "constraints", "safetyBoundary"],
  "properties": {
    "apiVersion": { "const": "certificateDB/v1" },
    "kind": { "const": "DerivedConstraintBundle" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "deviceRef": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } },
    "derivation": { "$ref": "#/$defs/derivation" },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
    "safetyBoundary": { "const": "evidence_derived_constraint_not_rf_permission" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "generatedAt"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "ruleVersion"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "ruleVersion": { "type": "string", "minLength": 1 }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "sourceRefs"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "integer", "boolean", "array", "object", "null"] },
        "unit": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
