{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certificate-db.example/schemas/review-gate.schema.json",
  "title": "ReviewGate",
  "description": "A hash-bound review attestation for a trust-boundary change; never an RF authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "scope", "subject", "evidence", "review"],
  "properties": {
    "apiVersion": { "const": "certificateDB/v1" },
    "kind": { "const": "ReviewGate" },
    "scope": { "enum": ["verified_promotion", "regulatory_change", "deployment", "public_release"] },
    "subject": { "$ref": "#/$defs/boundFile" },
    "base": { "$ref": "#/$defs/boundFile" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boundFile" } },
    "review": { "$ref": "#/$defs/review" }
  },
  "$defs": {
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\./).+" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reviewer", "reviewedAt", "decision"],
      "properties": {
        "required": { "const": true },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "decision": { "const": "accepted" },
        "notes": { "type": "string" }
      }
    }
  }
}
